# ---------------------------------------------------------------- core (required)
DATABASE_URL=postgres://safqa:CHANGE_ME@localhost:5432/safqa
# DATABASE_SSL=require            # set for managed Postgres (Supabase/Neon)
# DATABASE_POOL_MAX=5
# production | demo  — stamped into the database on first migration and immutable afterwards
SAFQA_ENV=production
# 32+ random chars:  openssl rand -base64 48
SESSION_SECRET=
# Public URL of this deployment (used in docs/UI and by n8n)
SAFQA_PUBLIC_URL=https://safqa.example.com

# ---------------------------------------------------------------- n8n (required for automations)
# 24+ random chars; put the same value in an n8n "Header Auth" credential (Authorization: Bearer <secret>)
N8N_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
# Only if you use the direct webhook instead of the n8n Telegram Trigger
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Claude AI (optional; rule-based fallback exists)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- Meta publishing (optional; own Page/IG only)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# ---------------------------------------------------------------- tests
# TEST_DATABASE_URL=postgres://safqa:safqa@localhost:5432/safqa_test
