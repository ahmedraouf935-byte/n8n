{
  "name": "SAFQA — 14 Approved social publishing",
  "nodes": [
    {
      "id": "36dce5a3-caff-a131-4981-c21fdd64b48d",
      "name": "README",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -260
      ],
      "parameters": {
        "content": "## 14 Approved social publishing\nPublishes OWNER-APPROVED posts whose time has come to the owner's Facebook Page / Instagram professional account via the Graph API. Out-of-stock products are not published. Without Meta credentials, due posts are marked failed with a clear error.",
        "height": 220,
        "width": 520
      }
    },
    {
      "id": "4f6969a7-095a-4453-29e6-510879d4e23a",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "1cf0c3eb-9785-3458-5fb8-bbd5976222aa",
      "name": "Publish due posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-SAFQA-DOMAIN/api/v1/jobs/enqueue",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jobType: \"publish_due_posts\", idempotencyKey: \"publish_due_posts:\" + $now.setZone('Africa/Cairo').toFormat('yyyy-LL-dd-HH') + '-' + Math.floor($now.minute / 15), runNow: true }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "SAFQA API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [
        [
          {
            "node": "Publish due posts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Cairo",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    {
      "name": "safqa"
    }
  ],
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
