{
  "name": "SAFQA — 08 Price & stock freshness",
  "nodes": [
    {
      "id": "5f585ca8-cd59-dd76-fcad-8cdfd26a022f",
      "name": "README",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -260
      ],
      "parameters": {
        "content": "## 08 Price & stock freshness\nEvery 6 hours. Marks supplier quotes stale after the configured days and expires owner verifications — stale data cannot pass purchase gates.",
        "height": 220,
        "width": 520
      }
    },
    {
      "id": "25f73472-36b5-1a5e-ae4b-a01a7862cb55",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "003d5af3-084b-d232-57ca-9988ed18946f",
      "name": "Enqueue refresh_freshness",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://safqa-indol.vercel.app/api/v1/jobs/enqueue",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jobType: \"refresh_freshness\", idempotencyKey: \"refresh_freshness:\" + $now.setZone('Africa/Cairo').toFormat('yyyy-LL-dd-HH'), runNow: true }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "SAFQA API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Enqueue refresh_freshness",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Africa/Cairo",
