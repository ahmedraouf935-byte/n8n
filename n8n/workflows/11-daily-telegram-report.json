      "typeVersion": 1,
      "position": [
        -40,
        -260
      ],
      "parameters": {
        "content": "## 11 Daily Telegram report\nBuilds the compact Arabic summary from recorded data (cash, candidates, unverified leads, pending approvals, stock alerts) and sends it with the SAFQA bot. If Telegram is not configured the notification is marked 'skipped' — visible in Settings → logs.",
        "height": 220,
        "width": 520
      }
    },
    {
      "id": "cbb4ed61-5666-7528-78bc-7127ecb9faeb",
      "name": "Daily 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
