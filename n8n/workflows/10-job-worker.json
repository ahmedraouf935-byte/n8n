      ],
      "parameters": {
        "content": "## 10 Job queue worker\nHourly safety net: runs queued jobs and retries failed ones with exponential backoff (jobs that fail 3 times are marked dead and alert the owner). Scheduled workflows already run their job immediately, so this only matters for retries.",
        "height": 220,
        "width": 520
      }
    },
    {
      "id": "71ea2ab4-f06c-52cc-cc8e-9a00ba051c97",
      "name": "Hourly at :25",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "25 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "9d1c6559-6b77-5e33-d49e-8e4da3e8b9fb",
      "name": "Run ready jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://safqa-indol.vercel.app/api/v1/jobs/tick",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "SAFQA API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
